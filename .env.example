# Tollgate scorer -- optional environment configuration.
#
#   cp .env.example .env      then edit the values you need.
#
# Every value here is OPTIONAL: with no .env at all the scorer runs on the
# template narrator and the in-memory window store. A real environment
# variable (an inline `KEY=val uvicorn ...` prefix, or an `export`) always
# overrides the matching line below.

# --- Narrator -------------------------------------------------------------

# Which narrative backend to use. "template" (default) is deterministic and
# needs no network. "gemini" dispatches an out-of-band LLM call after the
# incident is scored and REPLACES the template narrative on success; on any
# failure the template narrative is kept.
NARRATOR_BACKEND=template

# Google AI Studio API key. Required only when NARRATOR_BACKEND=gemini.
# Leave blank and the narrator silently stays on the template.
GEMINI_API_KEY=

# Comma-separated Gemini model fallback chain, tried in order. A model that
# returns HTTP 404/400 (retired / unknown) advances to the next; every other
# fault falls straight back to the template. Overrides the built-in default
# chain. The legacy single-value GEMINI_MODEL is still honoured if set.
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Set to "false" to disable the narrator entirely (template only). The
# evaluation harness forces this regardless of the value here.
NARRATOR_ENABLED=true

# --- Infrastructure ----------------------------------------------------------

# Redis connection for the sliding-window store. Unset or unreachable falls
# back to the in-process InMemoryWindowStore.
TOLLGATE_REDIS_URL=redis://localhost:6379

# HMAC secret for POST /v1/outcome. Unset -> that route returns 503; the rest
# of the service is unaffected. Printed by `python -m scripts.seed_merchant`.
TOLLGATE_OUTCOME_SECRET=
