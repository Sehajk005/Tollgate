# Source: Day 9 Plan Phase 2 -- the env_file every Compose service reads
# (`env_file: deploy/compose.env`, declared `required: false`).
#
# You normally do NOT create this by hand. The one-shot `bootstrap` service
# (scripts/compose_bootstrap.py) writes `deploy/compose.env` before the scorer
# starts:
#   * fresh checkout (no merchant row) -> it seeds a merchant and writes the
#     new key + secret here.
#   * merchant already in tollgate.db -> it copies the key that hashes to the
#     stored row from services/dashboard/.env, services/storefront/.env, or
#     .env into here. If none match it FAILS LOUDLY rather than emit a dead key.
#
# Provide this file yourself only when you have the key/secret out of band and
# want to skip the discovery step. It is gitignored -- never commit real values.

# Per-merchant API key. Sent by both frontends as X-Tollgate-Key and injected
# into the Vite build as VITE_TOLLGATE_API_KEY.
VITE_TOLLGATE_API_KEY=

# HMAC secret bound to the merchant row; required for POST /v1/outcome
# (unset -> that route 503s, the rest of the service is unaffected).
TOLLGATE_OUTCOME_SECRET=

# D6 config hash of the working tree, computed by the bootstrap
# (eval.provenance.config_hash). Passed to the dashboard as TG_CONFIG_HASH so
# the Metrics page can disclose evaluation-snapshot freshness even though the
# node image has no Python to compute it itself. 64 lowercase hex chars.
TG_CONFIG_HASH=
