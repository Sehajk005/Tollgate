# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Runtime / local data
*.db
*.db-wal
*.db-shm
spool/
*.log

# Day-2 raw dataset (43.5 MB, downloaded once by scripts/distill_baseline.py;
# only the derived data/baseline/*.profile.json is committed)
data/baseline/*.xlsx

# Day-4 eval harness output (regenerated by `python -m eval.harness`)
eval/outputs/*
!eval/outputs/.gitkeep
# Day-8 Plan Step 4 -- the D6 evaluation artifact IS committed (D6Metrics.jsx
# static-imports it; a clean clone must render D6 with zero live computation).
!eval/outputs/d6.json

# Day-5 model artifacts (Day-5 Plan §8): the LightGBM booster is regenerated
# by `python -m scripts.train_l1`; only the JSON artifacts (ModelArtifact,
# Calibrator, audit) are committed.
models/*.txt
models/*.db
# Day-5 replay corpus DB (`python -m scripts.train_l1 --rebuild-corpus`);
# also matched by the *.db rule above, listed here for discoverability.
data/corpus/

# Node
node_modules/
dist/
# Vite writes this transient ESM shim next to vite/vitest config files while
# resolving an ESM config; it is never source.
*.timestamp-*.mjs
# Day 9: Playwright regenerates these on every run -- HTML report + trace/video
# bundles + the .last-run.json marker (a repo-root test-results/ appears when the
# suite is run from the repo root). The classified results live in
# DAY-9-TEST-RESULTS.md + evidence/.
services/dashboard/playwright-report/
services/dashboard/blob-report/
test-results/

# Environment / secrets
.env
.env.*
!.env.example
# Day 9 Phase 2: the env_file the Compose stack reads. scripts.compose_bootstrap
# writes the merchant API key + outcome secret + TG_CONFIG_HASH here. Never
# commit; deploy/compose.env.example documents the shape.
deploy/compose.env

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Worktrees (agent-managed isolated workspaces)
.worktrees/

# Skills
.superpowers
# Source: remediation plan §17 -- scripts/verify_60x.py scratch output
.verify60x/
